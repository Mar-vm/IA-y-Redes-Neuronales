{
  "expo": {
    "name": "VitalIA",
    "slug": "vitalia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C447C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tecnm.vitalia"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C447C"
      },
      "package": "com.tecnm.vitalia"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "scheme": "vitalia"
  }
}
