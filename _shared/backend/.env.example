# Copia este archivo como .env y configura las variables
# En Render: Environment > Add Environment Variable

# Ruta al modelo .pth (debe estar en el repo o en un volumen de Render)
MODEL_PATH=modelo_produccion.pth

# Ruta al config.json del proyecto (opcional)
CONFIG_PATH=config.json

# Tamaño máximo de imagen en MB
MAX_SIZE_MB=10
